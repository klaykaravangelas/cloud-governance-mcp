# S3 decisions consume only four ordered booleans/states and proved graph links.
package cloud_governance_s3

import rego.v1

flags := ["BLOCK_PUBLIC_ACLS", "IGNORE_PUBLIC_ACLS", "BLOCK_PUBLIC_POLICY", "RESTRICT_PUBLIC_BUCKETS"]
state_names := {"sensitive": "SENSITIVE", "unknown": "UNKNOWN", "unverified": "UNVERIFIED", "unavailable": "UNAVAILABLE", "missing": "MISSING", "null": "NULL", "invalid_type": "INVALID_TYPE", "not_found": "NOT_FOUND", "ambiguous": "AMBIGUOUS", "context_unverified": "CONTEXT_UNVERIFIED"}

# Ordered traversals choose one stable witness, never one check per flag.
priority := ["sensitive", "unknown", "unverified", "unavailable", "missing", "null", "invalid_type"]
code_map := {
	"BLOCK": {
		"BLOCK_PUBLIC_ACLS": {"SENSITIVE": "S3_BLOCK_BLOCK_PUBLIC_ACLS_SENSITIVE", "UNKNOWN": "S3_BLOCK_BLOCK_PUBLIC_ACLS_UNKNOWN", "UNVERIFIED": "S3_BLOCK_BLOCK_PUBLIC_ACLS_UNVERIFIED", "UNAVAILABLE": "S3_BLOCK_BLOCK_PUBLIC_ACLS_UNAVAILABLE", "MISSING": "S3_BLOCK_BLOCK_PUBLIC_ACLS_MISSING", "NULL": "S3_BLOCK_BLOCK_PUBLIC_ACLS_NULL", "INVALID_TYPE": "S3_BLOCK_BLOCK_PUBLIC_ACLS_INVALID_TYPE", "DISABLED": "S3_BLOCK_BLOCK_PUBLIC_ACLS_DISABLED"},
		"IGNORE_PUBLIC_ACLS": {"SENSITIVE": "S3_BLOCK_IGNORE_PUBLIC_ACLS_SENSITIVE", "UNKNOWN": "S3_BLOCK_IGNORE_PUBLIC_ACLS_UNKNOWN", "UNVERIFIED": "S3_BLOCK_IGNORE_PUBLIC_ACLS_UNVERIFIED", "UNAVAILABLE": "S3_BLOCK_IGNORE_PUBLIC_ACLS_UNAVAILABLE", "MISSING": "S3_BLOCK_IGNORE_PUBLIC_ACLS_MISSING", "NULL": "S3_BLOCK_IGNORE_PUBLIC_ACLS_NULL", "INVALID_TYPE": "S3_BLOCK_IGNORE_PUBLIC_ACLS_INVALID_TYPE", "DISABLED": "S3_BLOCK_IGNORE_PUBLIC_ACLS_DISABLED"},
		"BLOCK_PUBLIC_POLICY": {"SENSITIVE": "S3_BLOCK_BLOCK_PUBLIC_POLICY_SENSITIVE", "UNKNOWN": "S3_BLOCK_BLOCK_PUBLIC_POLICY_UNKNOWN", "UNVERIFIED": "S3_BLOCK_BLOCK_PUBLIC_POLICY_UNVERIFIED", "UNAVAILABLE": "S3_BLOCK_BLOCK_PUBLIC_POLICY_UNAVAILABLE", "MISSING": "S3_BLOCK_BLOCK_PUBLIC_POLICY_MISSING", "NULL": "S3_BLOCK_BLOCK_PUBLIC_POLICY_NULL", "INVALID_TYPE": "S3_BLOCK_BLOCK_PUBLIC_POLICY_INVALID_TYPE", "DISABLED": "S3_BLOCK_BLOCK_PUBLIC_POLICY_DISABLED"},
		"RESTRICT_PUBLIC_BUCKETS": {"SENSITIVE": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_SENSITIVE", "UNKNOWN": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_UNKNOWN", "UNVERIFIED": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_UNVERIFIED", "UNAVAILABLE": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_UNAVAILABLE", "MISSING": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_MISSING", "NULL": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_NULL", "INVALID_TYPE": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_INVALID_TYPE", "DISABLED": "S3_BLOCK_RESTRICT_PUBLIC_BUCKETS_DISABLED"},
	},
	"BUCKET": {
		"BLOCK_PUBLIC_ACLS": {"SENSITIVE": "S3_BUCKET_BLOCK_PUBLIC_ACLS_SENSITIVE", "UNKNOWN": "S3_BUCKET_BLOCK_PUBLIC_ACLS_UNKNOWN", "UNVERIFIED": "S3_BUCKET_BLOCK_PUBLIC_ACLS_UNVERIFIED", "UNAVAILABLE": "S3_BUCKET_BLOCK_PUBLIC_ACLS_UNAVAILABLE", "MISSING": "S3_BUCKET_BLOCK_PUBLIC_ACLS_MISSING", "NULL": "S3_BUCKET_BLOCK_PUBLIC_ACLS_NULL", "INVALID_TYPE": "S3_BUCKET_BLOCK_PUBLIC_ACLS_INVALID_TYPE", "DISABLED": "S3_BUCKET_BLOCK_PUBLIC_ACLS_DISABLED"},
		"IGNORE_PUBLIC_ACLS": {"SENSITIVE": "S3_BUCKET_IGNORE_PUBLIC_ACLS_SENSITIVE", "UNKNOWN": "S3_BUCKET_IGNORE_PUBLIC_ACLS_UNKNOWN", "UNVERIFIED": "S3_BUCKET_IGNORE_PUBLIC_ACLS_UNVERIFIED", "UNAVAILABLE": "S3_BUCKET_IGNORE_PUBLIC_ACLS_UNAVAILABLE", "MISSING": "S3_BUCKET_IGNORE_PUBLIC_ACLS_MISSING", "NULL": "S3_BUCKET_IGNORE_PUBLIC_ACLS_NULL", "INVALID_TYPE": "S3_BUCKET_IGNORE_PUBLIC_ACLS_INVALID_TYPE", "DISABLED": "S3_BUCKET_IGNORE_PUBLIC_ACLS_DISABLED"},
		"BLOCK_PUBLIC_POLICY": {"SENSITIVE": "S3_BUCKET_BLOCK_PUBLIC_POLICY_SENSITIVE", "UNKNOWN": "S3_BUCKET_BLOCK_PUBLIC_POLICY_UNKNOWN", "UNVERIFIED": "S3_BUCKET_BLOCK_PUBLIC_POLICY_UNVERIFIED", "UNAVAILABLE": "S3_BUCKET_BLOCK_PUBLIC_POLICY_UNAVAILABLE", "MISSING": "S3_BUCKET_BLOCK_PUBLIC_POLICY_MISSING", "NULL": "S3_BUCKET_BLOCK_PUBLIC_POLICY_NULL", "INVALID_TYPE": "S3_BUCKET_BLOCK_PUBLIC_POLICY_INVALID_TYPE", "DISABLED": "S3_BUCKET_BLOCK_PUBLIC_POLICY_DISABLED"},
		"RESTRICT_PUBLIC_BUCKETS": {"SENSITIVE": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_SENSITIVE", "UNKNOWN": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_UNKNOWN", "UNVERIFIED": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_UNVERIFIED", "UNAVAILABLE": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_UNAVAILABLE", "MISSING": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_MISSING", "NULL": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_NULL", "INVALID_TYPE": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_INVALID_TYPE", "DISABLED": "S3_BUCKET_RESTRICT_PUBLIC_BUCKETS_DISABLED"},
	},
}

resources_by_address := {r.address: r | some r in input.resources}

flag_reason(p, kind) := code if {
	failures := [i | some i, flag in p.flags; flag.state == "known"; flag.value == false]
	code := code_map[kind][flags[failures[0]]].DISABLED
} else := code if {
	uncertain := [entry |
		some state in priority
		some i, flag in p.flags
		flag.state == state
		entry := {"i": i, "state": state}
	]
	first := uncertain[0]
	code := code_map[kind][flags[first.i]][state_names[first.state]]
} else := "S3_BLOCK_ENABLED" if {
	kind == "BLOCK"
	every flag in p.flags { flag.state == "known"; flag.value == true}
} else := "S3_BUCKET_ENABLED" if {
	kind == "BUCKET"
	every flag in p.flags { flag.state == "known"; flag.value == true}
}

link_codes := {
	"sensitive": "S3_LINK_SENSITIVE",
	"unknown": "S3_LINK_UNKNOWN",
	"unverified": "S3_LINK_UNVERIFIED",
	"unavailable": "S3_LINK_UNAVAILABLE",
	"missing": "S3_LINK_MISSING",
	"null": "S3_LINK_NULL",
	"invalid_type": "S3_LINK_INVALID_TYPE",
	"not_found": "S3_LINK_NOT_FOUND",
	"ambiguous": "S3_LINK_AMBIGUOUS",
	"context_unverified": "S3_LINK_CONTEXT_UNVERIFIED",
}

reason(r) := "DATA_SOURCE_SKIPPED" if r.mode == "data"

else := "DELETED_RESOURCE_SKIPPED" if r.action_category == "delete"

else := "RESOURCE_NOT_SUPPORTED" if r.provider_name != "registry.terraform.io/hashicorp/aws"

else := "RESOURCE_NOT_SUPPORTED" if {
	r.resource_type != "aws_s3_bucket"
	r.resource_type != "aws_s3_bucket_public_access_block"
} else := code if {
	r.s3_state.representation == "block"
	code := flag_reason(r.s3_state, "BLOCK")
} else := code if {
	r.s3_state.state != "resolved"
	code := link_codes[r.s3_state.state]
} else := code if {
	target := resources_by_address[r.s3_state.block_address]
	code := flag_reason(target.s3_state, "BUCKET")
}
